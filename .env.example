# MecFinder Backend Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ===========================================
# DATABASE
# ===========================================
# IMPORTANT: code reads `MONGO_URI` (not MONGODB_URI). Keep this name.
MONGO_URI=mongodb://localhost:27017/mecfinder

# ===========================================
# JWT TOKENS
# ===========================================
# Generate secure random strings for production
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# TWILIO (SMS OTP)
# ===========================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SID=your-twilio-verify-service-sid

# DEV MODE: Set to 'true' to use fixed OTP "123456" (for development only!)
DEV_OTP=true

# ===========================================
# RAZORPAY (PAYMENTS)
# ===========================================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Razorpay payment page (Razorpay.me) used for customer online payments
RAZORPAY_PAYMENT_PAGE_URL=https://razorpay.me/@mecfinders

# ===========================================
# CLOUDINARY (IMAGE UPLOADS)
# ===========================================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ===========================================
# REDIS (OPTIONAL - for caching & geospatial)
# ===========================================
# Use individual settings (preferred — used by Socket.IO Redis adapter):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
# Alternatively, REDIS_URL can be used by services that accept a connection URL:
# REDIS_URL=redis://localhost:6379

# Wallet withdrawal auto-settlement (Bull queue). Default 86400000 ms = 24h after request.
# Requires REDIS_HOST for durable delayed jobs; without Redis an in-process timer is used.
# PAYOUT_AUTO_DELAY_MS=86400000
# Minimum wallet withdrawal / payout (INR). Default 200 when unset. Use 5 only for local testing.
# MIN_PAYOUT_INR=200
# Development: allow Bull delay below 60s (default 0). Production always floors at 60s minimum.
# PAYOUT_MIN_SCHEDULE_MS=0
# Force UPI path to skip RazorpayX bank transfer (ledger-only). "true" or "1"
# PAYOUT_UPI_LEDGER_ONLY=false
# RazorpayX → My account → Account number (required for real UPI/bank payouts via API)
# RAZORPAYX_PAYOUT_ACCOUNT_NUMBER=

# ===========================================
# CORS & SECURITY
# ===========================================
# Comma-separated list of allowed origins. REQUIRED in production.
# In NODE_ENV=production, server will refuse to start if this is unset or '*'.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Dev-only example (do NOT use in production):
# CORS_ORIGIN=*

# ===========================================
# ADMIN PANEL
# ===========================================
ADMIN_EMAIL=admin@mecfinder.com
ADMIN_PASSWORD=change-this-secure-password
ADMIN_JWT_EXPIRES_IN=7d
ADMIN_REFRESH_TOKEN_EXPIRES_IN=30d

# ===========================================
# FIREBASE (PUSH NOTIFICATIONS - Optional)
# ===========================================
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_PRIVATE_KEY=your-firebase-private-key
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ===========================================
# PRODUCTION CHECKLIST
# ===========================================
# Before deploying to production, ensure:
# 1. NODE_ENV=production
# 2. DEV_OTP=false (or remove the variable)
# 3. All secrets are secure random strings
# 4. CORS_ORIGIN is set to your actual domains
# 5. All API keys are production keys (not test/sandbox)
# 6. MongoDB has proper authentication
# 7. Redis has password if exposed
# 8. The previously-committed FIREBASE_SERVICE_ACCOUNT_JSON has been ROTATED/REVOKED.
#    Paste the JSON for your service account on a single line, escaping newlines in
#    the private_key with \n. Do NOT commit real credentials to source control.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"REPLACE_WITH_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com","client_id":"REPLACE_WITH_CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxx%40your-project-id.iam.gserviceaccount.com","universe_domain":"googleapis.com"}



